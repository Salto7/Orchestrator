# LLM (LiteLLM)
LLM_PROVIDER=openrouter
LITELLM_MODEL=openrouter/openai/gpt-4o-mini
OPENROUTER_API_KEY=
# LITELLM_API_KEY=
# LITELLM_API_BASE=
LLM_TEMPERATURE=0
# LLM_MAX_TOKENS=4096

# Agent
AGENT_MAX_ITERATIONS=20
AGENT_MAX_FAILURE_REPLANS=2
AGENT_RUNTIME_ENABLED=true

# Sandbox
SANDBOX_ENABLED=true
SANDBOX_IMAGE=orchestrator-sandbox:local
SANDBOX_PREFIX=orchestrator
SANDBOX_REMOVE_ON_EXIT=false

# Paths (optional; defaults relative to cwd)
# SKILLS_DIR=./skills
# TOOLS_CATALOG_DIR=./tools/catalog
# PROJECT_WORKSPACES_DIR=./workspaces
